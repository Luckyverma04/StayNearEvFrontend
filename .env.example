# Copy to .env and fill in your values. Never commit the real .env.

# Backend API (local backend, or https://staynearevbackend.onrender.com/api)
VITE_API_URL=http://localhost:3002/api

# Google sign-in (same Client ID as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Show demo stations (local testing only — never set this on Render)
VITE_SHOW_DEMO=false
